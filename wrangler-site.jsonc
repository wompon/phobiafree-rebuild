{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phobiafree-site",
  "main": "site-worker.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "phobiafree_db",
      "database_name": "phobiafree-db",
      "database_id": "d535cc2f-b269-4b2e-b366-85dcaca0bf8b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHAT_FILES",
      "bucket_name": "phobiafree-chat-files"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.php",
      "/track",
      "/track/*",
      "/api/*",
      "/cursor_track.php",
      "/chat_handler.php",
      "/steven_status.php",
      "/consult_handler.php",
      "/welcome-*",
      "/editor",
      "/editor/",
      "/my_fear",
      "/my_fear/",
      "/my_fear.php",
      "/fear-of-*"
    ]
  },
  "routes": [
    { "pattern": "phobiafree.life", "custom_domain": true },
    { "pattern": "www.phobiafree.life", "custom_domain": true }
  ],
  "send_email": [
    { "name": "EMAIL" }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
